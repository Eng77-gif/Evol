{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.alienevo.necrofriggian_ov.movement": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            {
              "fly": "c.owning_entity->v.alienevo_fly"
            }
          ]
        },
        "fly": {
          "animations": [
            "move_fly"
          ],
          "blend_transition": 0.2,
          "transitions": [
            {
              "default": "!(c.owning_entity->v.alienevo_fly)"
            }
          ]
        }
      }
    }
  }
}
