{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.alienevo.lepidopterran": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            {
              "t1": "c.owning_entity->v.alienevo_anim == 1"
            },
            {
              "t2": "c.owning_entity->v.alienevo_anim == 2"
            },
            {
              "t3": "c.owning_entity->v.alienevo_anim == 3"
            }
          ]
        },
        "t1": {
          "animations": [
            "t1"
          ],
          "transitions": [
            {
              "t2": "c.owning_entity->v.alienevo_anim == 2"
            },
            {
              "t3": "c.owning_entity->v.alienevo_anim == 3"
            }
          ],
          "blend_transition": 0.15
        },
        "t2": {
          "animations": [
            "t2"
          ],
          "transitions": [
            {
              "t1": "c.owning_entity->v.alienevo_anim == 1"
            },
            {
              "t3": "c.owning_entity->v.alienevo_anim == 3"
            }
          ],
          "blend_transition": 0.15
        },
        "t3": {
          "animations": [
            "t3"
          ],
          "transitions": [
            {
              "t1": "c.owning_entity->v.alienevo_anim == 1"
            },
            {
              "t2": "c.owning_entity->v.alienevo_anim == 2"
            }
          ],
          "blend_transition": 0.15
        }
      }
    },
    "controller.animation.alienevo.lepidopterran.movement": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            {
              "fly": "c.owning_entity->v.alienevo_fly"
            }
          ]
        },
        "fly": {
          "animations": [
            "move_fly"
          ],
          "blend_transition": 0.2,
          "transitions": [
            {
              "default": "!(c.owning_entity->v.alienevo_fly)"
            }
          ]
        }
      }
    }
  }
}
