{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.alienevo.ectonurite": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            {
              "t1": "c.owning_entity->v.alienevo_anim == 1"
            },
            {
              "t2": "c.owning_entity->v.alienevo_anim == 2"
            }
          ]
        },
        "t1": {
          "animations": [
            "t1"
          ],
          "transitions": [
            {
              "t2": "c.owning_entity->v.alienevo_anim == 2"
            }
          ],
          "blend_transition": 0.15
        },
        "t2": {
          "animations": [
            "t2"
          ],
          "transitions": [
            {
              "t1": "c.owning_entity->v.alienevo_anim == 1"
            }
          ],
          "blend_transition": 0.15
        }
      }
    }
  }
}
