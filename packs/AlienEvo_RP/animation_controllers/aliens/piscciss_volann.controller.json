{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.alienevo.piscciss_volann": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            {
              "t1": "c.owning_entity->v.alienevo_anim == 1"
            },
            {
              "t2": "c.owning_entity->v.alienevo_anim == 2"
            }
          ]
        },
        "t1": {
          "animations": [
            "t1"
          ],
          "transitions": [
            {
              "t2": "c.owning_entity->v.alienevo_anim == 2"
            }
          ],
          "blend_transition": 0.15
        },
        "t2": {
          "animations": [
            "t2"
          ],
          "transitions": [
            {
              "t1": "c.owning_entity->v.alienevo_anim == 1"
            }
          ],
          "blend_transition": 0.15
        }
      }
    },
    "controller.animation.alienevo.piscciss_volann.movement": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            {
              "swim": "c.owning_entity->q.is_swimming"
            }
          ]
        },
        "swim": {
          "animations": [
            "move_swim"
          ],
          "blend_transition": 0.2,
          "transitions": [
            {
              "default": "!(c.owning_entity->q.is_swimming)"
            }
          ]
        }
      }
    }
  }
}
